# CycleBeat — environment template. Copy to .env and fill in.
#
# Phase 0 purge (ADR-001): Spotify and Qdrant variables removed — those bricks
# no longer exist. The purged stack needs NO key to run (E.8 zero cost); the
# LLM and music-source variables come back with phases 1 and 6.

# Warehouse
RUNTIME_DB_PATH=data/cyclebeat_runtime.duckdb

# Music sources — phase 1 source spike (tools/spike/README.md has the runbook).
# Both are free. Deezer needs no key: its public API is used unauthenticated.
# Leave empty and the spike degrades: no Jamendo id skips the decisive CC set,
# no GetSongBPM key reports that source as "not measured" instead of failing.
# GetSongBPM carries a MANDATORY BACKLINK obligation if the project ships it.
JAMENDO_CLIENT_ID=
GETSONGBPM_API_KEY=

# App
TZ=Europe/Paris

# Grafana (local monitoring stack)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
