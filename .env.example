# CycleBeat — environment template. Copy to .env and fill in.
#
# Phase 0 purge (ADR-001): Spotify and Qdrant variables removed — those bricks
# no longer exist. The purged stack needs NO key to run (E.8 zero cost); the
# LLM and music-source variables come back with phases 1 and 6.

# ── Stores (ADR-009: Postgres transactional, DuckDB analytical) ──────────────
# Warehouse — analytical. Built by the lake and dbt; the API only reads it.
RUNTIME_DB_PATH=data/cyclebeat_runtime.duckdb

# Transactional store — sessions and feedback.
#   LEAVE EMPTY and the app falls back to SQLite at data/cyclebeat_app.db. That is what a
#   clean clone gets, and it is why `uvicorn api.main:app` and `make test-unit` need no
#   service at all (E.8, criterion 14).
#   docker compose sets this to the local `postgres` container.
#   In production it is the Neon connection string — a SECRET, never committed (E.0.5).
DATABASE_URL=

# Overrides where the SQLite fallback lives. Only useful for tests, which point it at a
# temp file so they never touch a developer's real store.
APP_DB_PATH=

# Music sources — phase 1 source spike (tools/spike/README.md has the runbook).
# Deezer needs NO key at all: the public API and the 30 s preview are used
# unauthenticated, and ADR-005 makes that pair the BPM backbone. So the spike
# runs end to end with this section left entirely empty.
# GetSongBPM is an optional, never-adopted enrichment source: without a key it
# is reported as "not measured" instead of failing. It carries a MANDATORY
# BACKLINK obligation if the project ever ships it.
GETSONGBPM_API_KEY=

# App
TZ=Europe/Paris

# Grafana (local monitoring stack)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
