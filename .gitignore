# The SQLite fallback for the transactional store (ADR-009). Local state, like the
# warehouse beside it -- Postgres is the real store in compose and production.
data/*.db

# Per-machine Claude Code settings
.claude/settings.local.json

# Phase-1 spike: HTTP response cache and downloaded audio (E.8 permanent cache, but
# hundreds of MB of CC mp3 have no business in git). The raw measurement output next to
# it, data/spike/raw_output.json, IS committed — the report's figures must be traceable.
data/spike/.cache/

# Phase-2 Parquet lake and the preview cache that feeds it. Both are BUILD OUTPUT, not
# source: `make ingest` rebuilds the whole lake from data/spike/raw_output.json, which is
# committed. Keeping Parquet out of git is what lets the demo snapshot stay a readable,
# diffable JSON instead of a binary blob (E.8 asks for a committed snapshot, not a
# committed warehouse).
lake/
data/audio_cache/
data/airflow/
data/airflow.db

